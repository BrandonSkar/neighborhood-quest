{
  "name": "Lakeland Hills Quest",
  "short_name": "Quest",
  "description": "A kid-friendly neighborhood treasure hunt — scan QR codes at parks and schools to stamp your passport!",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#bce7ff",
  "theme_color": "#4aa8ff",
  "prefer_related_applications": false,
  "related_applications": [
    { "platform": "webapp", "url": "https://neighborhood-quest.vercel.app/manifest.webmanifest" }
  ],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
